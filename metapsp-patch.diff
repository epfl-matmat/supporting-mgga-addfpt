diff -ur metapsp-1.0.1/src/globalmath_loc.F90 metapsp-1.0.1/src/globalmath_loc.F90
--- metapsp-1.0.1/src/globalmath_loc.F90	2024-04-27 20:10:09.000000000 +0200
+++ metapsp-1.0.1/src/globalmath_loc.F90	2026-06-20 10:36:23.000000000 +0200
@@ -95,6 +95,19 @@
   END FUNCTION ddexp
 
   !**********************************************
+  ! 5th order "smootherstep" function: 0 for x <= 0, 1 for x >= 1, smooth in between
+  pure function smoothstep(x)
+    real(8), intent(in) :: x
+    real(8) :: smoothstep
+    if (x <= 0.0) then
+      smoothstep = 0.0
+    else if (x >= 1.0) then
+      smoothstep = 1.0
+    else
+      smoothstep = 6.0*x**5 - 15.0*x**4 + 10.0*x**3
+    end if
+  end function smoothstep
+
 
 END MODULE GlobalMath_loc
 
