+ ! smoothly force vpuns to be equal to -zion/r beyond the max rc (over a window of 1 a.u.)
+ do ii=1,mmax
+  do l1=1,max(lmax+1,lloc+1)
+    if (rr(ii) > rcmax) then
+      vpuns(ii,l1)=-zion/rr(ii) + (vpuns(ii,l1)+zion/rr(ii)) * smoothstep(1.0+(rcmax-rr(ii))/1.0)
